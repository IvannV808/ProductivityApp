<Window x:Class="ProductivityApp.PasswordSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master Password" Height="380" Width="460" MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Master Password" FontSize="20" FontWeight="SemiBold" Foreground="#242A31"/>
            <TextBlock x:Name="StatusText" Foreground="#657080" Margin="0,5,0,18" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <StackPanel x:Name="CurrentPasswordPanel">
                <TextBlock Text="Current password" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="CurrentPasswordInput" Height="34" VerticalContentAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="New password" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <PasswordBox x:Name="NewPasswordInput" Height="34" VerticalContentAlignment="Center"/>

            <TextBlock Text="Confirm new password" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <PasswordBox x:Name="ConfirmPasswordInput" Height="34" VerticalContentAlignment="Center"/>

            <TextBlock x:Name="ValidationText" Foreground="#B3261E" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <Button x:Name="ClearButton" Content="Clear Password" Width="116" Height="34"
                    HorizontalAlignment="Left" Click="ClearButton_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="84" Height="34" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Save" Width="84" Height="34" Click="SaveButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
