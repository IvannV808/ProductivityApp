<Window x:Class="ProductivityApp.AppConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App Config" Height="620" Width="920" MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9">
    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#242A31"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DDE2EA" BorderThickness="1" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Running Apps" Style="{StaticResource SectionTitleStyle}"/>
                    <Button Content="Refresh" Width="92" Height="32" HorizontalAlignment="Left" Margin="0,0,0,10"
                            Click="RefreshButton_Click"/>
                </StackPanel>

                <ListBox x:Name="RunningAppsList"
                         SelectionMode="Extended"
                         DisplayMemberPath="DisplayText"
                         PreviewMouseMove="RunningAppsList_PreviewMouseMove"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
            <Button Content="Move to Block" Width="130" Height="38" Click="MoveToBlockButton_Click"/>
        </StackPanel>

        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#DDE2EA" BorderThickness="1" Padding="14"
                AllowDrop="True" Drop="BlockedAppsPanel_Drop" DragOver="BlockedAppsPanel_DragOver">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Targeted for Blocking" Style="{StaticResource SectionTitleStyle}"/>
                    <Button Content="Remove Selected" Width="126" Height="32" HorizontalAlignment="Left" Margin="0,0,0,10"
                            Click="RemoveSelectedButton_Click"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" x:Name="DatabasePathText" Foreground="#657080" FontSize="12"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                <ListBox x:Name="BlockedAppsList" DisplayMemberPath="DisplayName" SelectionMode="Extended"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
