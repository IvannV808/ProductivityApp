<Window x:Class="ProductivityApp.ScheduleBlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Block" Height="540" Width="440" MinHeight="480" MinWidth="390"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="DayText" FontSize="20" FontWeight="SemiBold" Foreground="#242A31"/>
            <TextBlock Text="Choose a time range and the apps to close during that block."
                       Foreground="#657080" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Start time" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="StartTimeCombo" Height="34"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="End time" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="EndTimeCombo" Height="34"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Block color" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="ColorCombo" Height="34"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#DDE2EA" BorderThickness="1" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Target apps" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="EmptyAppsText" Foreground="#9AA4B2" TextWrapping="Wrap"
                           Margin="0,8,0,0" Visibility="Collapsed"
                           Text="No target apps have been added yet. Use App Config first."/>
                <ListBox x:Name="TargetAppsList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Content="{Binding DisplayName}" Margin="0,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#B3261E" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="84" Height="34" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Save" Width="84" Height="34" Click="SaveButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
