<Window x:Class="ProductivityApp.ExitChallengeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Exit" Height="400" Width="580" MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Confirm Exit" FontSize="20" FontWeight="SemiBold" Foreground="#242A31"/>
            <TextBlock Text="Use either the randomized string or your master password to close the app."
                       Foreground="#657080" Margin="0,6,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DDE2EA" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Text="Randomized string" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="ChallengeText" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" IsHitTestVisible="False"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Type randomized string" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="ChallengeInput" Height="36" VerticalContentAlignment="Center" FontFamily="Consolas"
                     ContextMenu="{x:Null}" PreviewKeyDown="ChallengeInput_PreviewKeyDown"/>

            <TextBlock Text="Or master password" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <PasswordBox x:Name="PasswordInput" Height="36" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="PasswordUnavailableText" Foreground="#657080" Margin="0,6,0,0"
                       Text="Set a master password from the main window settings to use this option."
                       TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock x:Name="ValidationText" Foreground="#B3261E" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="84" Height="34" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Exit" Width="84" Height="34" Click="ExitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
