<Window x:Class="ProductivityApp.MetricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metrics" Height="720" Width="1040" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Metrics" FontSize="24" FontWeight="SemiBold" Foreground="#242A31"/>
            <Button DockPanel.Dock="Right" Content="Refresh" Width="92" Height="32" Click="RefreshButton_Click"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DDE2EA" BorderThickness="1" Padding="12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="From" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDatePicker" Width="132" SelectedDateChanged="Filter_Changed"/>
                <TextBlock Text="To" VerticalAlignment="Center" FontWeight="SemiBold" Margin="18,0,8,0"/>
                <DatePicker x:Name="ToDatePicker" Width="132" SelectedDateChanged="Filter_Changed"/>
                <TextBlock Text="Group" VerticalAlignment="Center" FontWeight="SemiBold" Margin="18,0,8,0"/>
                <ComboBox x:Name="GroupModeCombo" Width="116" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Daily" IsSelected="True"/>
                    <ComboBoxItem Content="Weekly"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Usage Time">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#FFFFFF" BorderBrush="#DDE2EA" BorderThickness="1" Padding="12" Margin="0,0,14,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Apps" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListBox x:Name="AppsList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="MetricAppCheckBox_Click"
                                                  Margin="0,4"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="300"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#FFFFFF" BorderBrush="#DDE2EA" BorderThickness="1" Padding="12">
                            <Grid>
                                <Canvas x:Name="UsageChartCanvas" SizeChanged="UsageChartCanvas_SizeChanged"/>
                                <TextBlock x:Name="EmptyChartText" Text="No foreground app usage has been recorded for this range yet."
                                           Foreground="#657080" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="LegendPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10"/>

                        <DataGrid x:Name="UsageGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" Background="#FFFFFF" BorderBrush="#DDE2EA" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="160"/>
                                <DataGridTextColumn Header="App" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="Time Used" Binding="{Binding TimeSpent}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Closed Apps">
                <Border Background="#FFFFFF" BorderBrush="#DDE2EA" BorderThickness="1" Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ClosureMetricsPanel" Margin="14"/>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
