<Window x:Class="ProductivityApp.MotivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Back to Work" Height="190" Width="460" MinHeight="170" MinWidth="380"
        WindowStartupLocation="CenterScreen" Topmost="True" Background="#F6F7F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" FontSize="17" FontWeight="SemiBold"
                   Foreground="#242A31" TextWrapping="Wrap" VerticalAlignment="Center"/>

        <Button Grid.Row="1" Content="OK" Width="84" Height="34" HorizontalAlignment="Right"
                Margin="0,16,0,0" Click="OkButton_Click"/>
    </Grid>
</Window>
